<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_view_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), ('state', '=', 'approved')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
