<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_view_approval" model="ir.ui.view">
        <field name="name">stock.picking.form.approval</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list//field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">[('state', '=', 'approved')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>