<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_view_approval" model="ir.ui.view">
        <field name="name">account.move.form.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">[('state', '=', 'approved')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
