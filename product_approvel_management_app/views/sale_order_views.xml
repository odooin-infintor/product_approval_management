<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_approval" model="ir.ui.view">
        <field name="name">sale.order.form.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']"
                   position="attributes">
                <attribute name="domain">[('sale_ok', '=', True), ('state', '=', 'approved')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
