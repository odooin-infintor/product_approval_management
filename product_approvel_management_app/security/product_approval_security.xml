<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_approval" model="ir.module.category">
        <field name="name">Product Approval</field>
        <field name="description">Manage who can approve or reject new products.</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_product_approval" model="res.groups.privilege">
        <field name="name">Product Approval</field>
        <field name="category_id" ref="module_category_product_approval"/>
    </record>

    <record id="group_product_manager" model="res.groups">
        <field name="name">Product Manager</field>
        <field name="privilege_id" ref="privilege_product_approval"/>
        <field name="comment">
            Users in this group can approve, reject and reset products, and
            receive notifications when a product is submitted for approval.
        </field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>