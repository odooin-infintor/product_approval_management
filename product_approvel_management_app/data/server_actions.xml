<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_server_mass_approve_product" model="ir.actions.server">
        <field name="name">Mass Approve</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_mass_approve()</field>
    </record>

    <record id="action_server_mass_reject_product" model="ir.actions.server">
        <field name="name">Mass Not Approve</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_mass_reject()</field>
    </record>
</odoo>
