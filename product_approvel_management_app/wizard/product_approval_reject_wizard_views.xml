<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">product.approval.reject.wizard.form</field>
        <field name="model">product.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Product(s)">
                <group>
                    <field name="product_ids" widget="many2many_tags" readonly="1"/>
                    <field name="reason" placeholder="Explain why these products are not approved..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Confirm Reject" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
